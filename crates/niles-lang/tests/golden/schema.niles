// The one schema every golden case is written against.
//
// Small on purpose, and shaped so the interesting SQL cases have somewhere to land: two
// relations that join, a nullable column so the three-valued cases are real, and an `edges`
// relation for the transitive closure.

schema g {
    currency usd { scale: 2 }

    base t {
        k: Int,
        v: Int,
        n: Int,
        retain forever;
    }

    base u {
        k: Int,
        w: Int,
        retain forever;
    }

    base edges {
        src: Int,
        dst: Int,
        retain forever;
    }

    // A relation with a sealed column, for the confidentiality goldens. `owner` is
    // `@confidential`, so the engine may carry it to a caller and may not compute on it;
    // `who` is the subject the seal names, and is readable because an erasure has to look it
    // up to find the keys it must destroy. Typed `Int` because the golden corpus's data is
    // integers — confidentiality is a property of a column, not of its type.
    base p {
        who: Int,
        owner: Int @confidential(e2ee, subject = who),
        n: Int,
        retain forever;
    }

    // Negative and tying sums, for the bounded top-k case. A separate relation because
    // `t`'s values are all positive and every case above is written against them: a
    // selection algorithm and a full sort differ exactly where the ordering key ties and
    // where the sign changes, and neither is expressible over `t`.
    base q {
        k: Int,
        v: Int,
        retain forever;
    }

    index ix_t on t (k) anchor;
    index ix_u on u (k) anchor;
    index ix_edges on edges (src) anchor;
    index ix_q on q (k) anchor;
}
