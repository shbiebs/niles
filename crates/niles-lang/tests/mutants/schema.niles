// The schema every corpus function is checked against.
//
// Deliberately the shape of `gbs/niles/gbs.niles` rather than a minimal one: the question
// E18 asks is how the solver behaves on *realistic* banking code, and a schema with one
// currency and one relation would make the answer flattering and useless.

schema corpus {
    currency usd { scale: 2 }
    currency eur { scale: 2 }
    currency gbp { scale: 2 }
    currency jpy { scale: 0 }

    table accounts {
        id: Id<Account> primary key,
        owner: Id<Party>,
        cur: Currency,
        class: Text,
        nature: Text,
        opened_at: Instant,
    }

    ledger postings {
        txn: TxnId,
        acct: Id<Account>,
        cur: Currency,
        amt: Money,
        value_date: Date,
        idem: IdemKey window 1_000_000.epochs,
        conserve per (txn, cur);
        retain forever;
        bitemporal;
    }

    base holds {
        id: HoldId,
        acct: Id<Account>,
        cur: Currency,
        amount: Money,
        expires: Instant,
        idem: IdemKey window 250_000.epochs,
        retain forever;
    }

    base fixings {
        index_name: Text,
        value: Int,
        scale: Int,
        observed_on: Date,
        retain forever;
        bitemporal;
    }

    index ix_postings on postings (acct) anchor;
    index ix_holds on holds (acct) anchor;
}

// Two reference views, one at each end of the ladder. Every mutant that turns on a rung
// reads one of them, so the rung is a property of the *schema* rather than something the
// mutant sets up for itself — a mutant that could choose its own rung could be made to
// pass by changing the setup rather than the rule.
view stale_balance = postings.group_by(|p| p.acct).sum(|p| p.amt)
    serve { consistency: bounded(epochs: 8, millis: 500), materialize: auto };

view fresh_balance = postings.group_by(|p| p.acct).sum(|p| p.amt)
    serve { consistency: ledger_consistent, materialize: demand, lineage: key };
