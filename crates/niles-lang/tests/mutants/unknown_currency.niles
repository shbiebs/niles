// RULE: W6. A currency is a declaration, not a spelling.
// EXPECT: NL0241
// STAGE: check
fn f(a: Id<Account>, b: Id<Account>) -> Result<TxnId, TxnError>
    ! { append, debit<xbt>, credit<xbt> }
{
    txn idem("f", window: 30.days) {
        post(debit(a, 1.00 xbt)?, credit(b, 1.00 xbt))
    }
}
