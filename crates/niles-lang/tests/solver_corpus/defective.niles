// Five functions with real conservation defects. The **negative control**.
//
// Without these the corpus would establish only that the checker is quiet, which is a property
// a checker that returned `Conserves` unconditionally would also have. Each of these must be
// caught — as `Violates` where the arithmetic is straight-line and provably wrong, and as
// `MayViolate` where the same arithmetic is reached along a path the checker cannot guarantee
// is taken.
//
// The distinction between those two is the honesty of the analysis rather than a detail. An
// accusation must be a must-statement: a checker that says "this transaction cannot balance"
// about a program it could not follow teaches its users to switch it off.

// ── D1: the lost cent ───────────────────────────────────────────────────────────────
//
// The classic. Three legs, and the fee does not close the gap. Off by one minor unit, which
// is exactly the size that survives review and shows up in a reconciliation nine months later.
fn transfer_with_lost_cent(
    from: Id<Account>,
    to: Id<Account>,
    fees: Id<Account>,
) -> Result<TxnId, TxnError>
    ! { append, debit<usd>, credit<usd> }
{
    txn idem("lost-cent", window: 30.days) {
        post(
            debit(from, 100.00 usd)?,
            credit(to, 99.75 usd),
            credit(fees, 0.24 usd),
        )
    }
}

// ── D2: the syndicated residue ──────────────────────────────────────────────────────
//
// 100.00 split three ways as 33.33 each, against a 100.00 movement. One cent short per
// drawdown, on a facility that draws weekly for seven years.
fn syndicated_residue(
    borrower: Id<Account>,
    lender_a: Id<Account>,
    lender_b: Id<Account>,
    lender_c: Id<Account>,
) -> Result<TxnId, TxnError>
    ! { append, debit<usd>, credit<usd> }
{
    txn idem("residue", window: 30.days) {
        post(
            debit(lender_a, 33.33 usd)?,
            debit(lender_b, 33.33 usd)?,
            debit(lender_c, 33.33 usd)?,
            credit(borrower, 100.00 usd),
        )
    }
}

// ── D3: the currency mix ────────────────────────────────────────────────────────────
//
// Sums to zero if you ignore the currency, and is a thousand-unit hole if you do not. The
// defect per-currency conservation exists to catch, and the one an aggregate check passes.
fn currency_mix(a: Id<Account>, b: Id<Account>)
    -> Result<TxnId, TxnError>
    ! { append, debit<usd>, credit<eur> }
{
    txn idem("currency-mix", window: 30.days) {
        post(debit(a, 1000.00 usd)?, credit(b, 1000.00 eur))
    }
}

// ── D4: the doubled leg ─────────────────────────────────────────────────────────────
//
// A copy-paste that credits the beneficiary twice. The total is wrong by exactly one leg,
// which is the failure mode of every transaction written by editing the one above it.
fn doubled_credit(from: Id<Account>, to: Id<Account>)
    -> Result<TxnId, TxnError>
    ! { append, debit<usd>, credit<usd> }
{
    txn idem("doubled", window: 30.days) {
        post(
            debit(from, 250.00 usd)?,
            credit(to, 250.00 usd),
            credit(to, 250.00 usd),
        )
    }
}

// ── D5: the defect on one branch only ───────────────────────────────────────────────
//
// The interesting one. The `else` branch is unbalanced, and the checker reaches it across a
// control-flow merge — so the correct verdict is `MayViolate` rather than `Violates`: the
// arithmetic is wrong, and whether this program ever executes that path is not something the
// checker can decide.
//
// A checker that reported this as a must-violation would be over-claiming; one that stayed
// silent would be missing a real defect. The middle verdict is what the analysis is for.
fn unbalanced_on_one_branch(
    from: Id<Account>,
    to: Id<Account>,
    fees: Id<Account>,
    waived: Bool,
) -> Result<TxnId, TxnError>
    ! { append, debit<usd>, credit<usd> }
{
    txn idem("branch-defect", window: 30.days) {
        if waived {
            post(debit(from, 100.00 usd)?, credit(to, 100.00 usd))
        } else {
            post(
                debit(from, 100.00 usd)?,
                credit(to, 99.00 usd),
                credit(fees, 0.50 usd),
            )
        }
    }
}
