fn task(a: Id<Account>, b: Id<Account>, f: Id<Account>, m: Money<usd>, fee: Money<usd>)
    -> Result<TxnId, TxnError>
    ! { append, debit<usd>, credit<usd> }
{
    txn idem("t02") {
        let d = debit(a, m)?;
        let c = credit(b, m - fee);
        let k = credit(f, fee);
        post(d, c, k)
    }
}
