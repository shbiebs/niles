// The worked program of thesis Appendix B.20.
//
// Everything in this file is accepted by the stage-0 compiler in `crates/niles-lang`:
// `nilesc check examples/demo_bank.niles` reports no errors, and `nilesc explain` prints
// the IR circuit each view lowers to. It is kept compiling by `tests/examples.rs`, so the
// thesis's worked example cannot drift away from the language it describes.

schema demo_bank {
    currency usd { scale: 2 }
    currency eur { scale: 2 }
    currency jpy { scale: 0 }

    table accounts {
        id: Id<Account> primary key,
        owner: Text @confidential(e2ee),
        opened_at: Instant,
    }

    // The authoritative base. Immutable, fully retained, epoch-ordered; `update` and
    // `delete` have no meaning here, and the conservation rule is checked at every seal.
    ledger postings {
        txn: TxnId,
        acct: Id<Account>,
        cur: Currency,
        amt: Money,
        value_date: Date,
        idem: IdemKey window 30.days,
        conserve per (txn, cur);
        retain forever;
        bitemporal;
    }

    // A `base`, not a `ledger`. The stage-0 compiler caught this: a `ledger` must declare
    // a conservation rule, and a hold does not conserve — it is a one-sided encumbrance,
    // not a double-entry movement. Declaring it a ledger would have promised a
    // double-entry invariant that no hold ever satisfies. It is still immutable and fully
    // retained; what it is not is conserved.
    base holds {
        id: HoldId,
        acct: Id<Account>,
        cur: Currency,
        amount: Money,
        expires: Instant,
        idem: IdemKey window 7.days,
        retain forever;
    }

    // Anchor indices are mandatory on ledger keys: reconstruction must reach a key's rows
    // without scanning the ledger, and the checkpoint interval is what bounds the fold.
    index by_acct on postings (acct, cur) anchor;
    index by_hold_acct on holds (acct, cur) anchor;

    // Rung 2 is enough for a balance a customer reads back after their own payment.
    view ledger_balance = postings
        .group_by(|p| (p.acct, p.cur))
        .sum(|p| p.amt)
        serve { consistency: read_your_writes, materialize: auto, retain: evictable };

    // The authorization path. Rung 5, because a decision to move money must see every
    // committed write that precedes it in real time; `demand` because the access is skewed
    // and the optimizer is not permitted to trade the rung for memory.
    //
    // NOTE — this view originally derived from `ledger_balance`, and the compiler rejected
    // it (NL0311, rung monotonicity): `ledger_balance` is served at `read_your_writes`, so
    // an availability decision built on it would have been at most read-your-writes fresh
    // however strict this contract claimed to be. The staleness entered one hop upstream
    // and no downstream annotation removes it. That is exactly the failure supervisory
    // guidance describes as two derived views of one ledger disagreeing at the moment a
    // decision is made — and it was present in this thesis's own worked example until the
    // effect calculus was run over it. The fix is to derive from the base directly.
    view available_balance = postings
        .group_by(|p| (p.acct, p.cur))
        .sum(|p| p.amt)
        serve { consistency: ledger_consistent, materialize: demand, lineage: key };

    // A statement view: bounded staleness is correct here and cheaper by two rungs.
    //
    // NOTE — the predicate was originally `p.value_date >= month_start()`, and the IR
    // verifier rejected it (IR013): `month_start()` reads the wall clock, so it is not
    // reproducible, so a reconstruction of an evicted entry could disagree with the value
    // it replaced. That is not a lint. It would make the reconstruction-equivalence
    // theorem false for this view rather than merely unproven — a balance recomputed after
    // an eviction could legitimately differ from the one evicted, and no audit could tell
    // that apart from a bug. A view boundary must be a value, not a moment.
    view statement_mtd = postings
        .where(|p| p.value_date >= v@2026-08-01)
        .group_by(|p| p.acct)
        .sum(|p| p.amt)
        serve { consistency: bounded(epochs: 10, millis: 30000), materialize: demand,
                retain: evictable, budget: 50000 };
}

// A transfer. The effect row is part of the signature: a caller can see, from the type
// alone, that this function appends to the ledger and debits in USD.
fn pay_rent(tenant: Id<Account>, landlord: Id<Account>) -> Result<TxnId, TxnError>
    ! { append, debit<usd>, credit<usd> }
{
    let rent = 850.00 usd;
    txn idem("rent-2026-08", window: 30.days) {
        let d = debit(tenant, rent)?;
        let c = credit(landlord, rent);
        post(d, c)
    }
}

// A hold and its resolution. The hold is linear: the type system rejects a program that
// resolves it twice, or that lets it fall out of scope unresolved.
fn card_authorization(acct: Id<Account>, amount: Money<usd>) -> Result<TxnId, TxnError>
    ! { append, hold<usd> }
{
    let h = hold(acct, amount, expires: 7.days)?;
    resolve h post 18.50 usd
}

// Atomic cross-currency movement: two conserved legs sealed in one epoch. There is no
// single currency in which this transaction sums to zero, which is exactly why it needs a
// form of its own rather than a pair of transfers.
// The declared row below was also wrong in the thesis's printed example: it said
// `debit<usd>, credit<eur>`, as if a conversion debited one currency and credited the
// other. It does not, and cannot — that would not conserve either currency. An `fx` form
// is *two* conserved legs, so it debits and credits in both.
fn settle_fx(a: Id<Account>, b: Id<Account>, r: Rate) -> Result<TxnId, TxnError>
    ! { append, debit<usd>, credit<usd>, debit<eur>, credit<eur> }
{
    txn idem("fx-991") {
        fx {
            leg usd_side: post(debit(a, 1000.00 usd)?, credit(b, 1000.00 usd)),
            leg eur_side: post(debit(b, 920.00 eur)?, credit(a, 920.00 eur)),
            rate: r,
        }
    }
}

// The SQL surface lowers to the same IR as the pipeline surface above.
view sql_balances = sql {
    select acct, cur, sum(amt) as balance
    from postings
    group by acct, cur
} serve { consistency: snapshot, materialize: auto };

// Two reads at two rungs, and the row names both. `explain` reads at `snapshot` — it
// asks what a value was derived from, which is a question about a materialised state
// rather than about the ledger — and `available_balance.get` reads at
// `ledger_consistent`. The row used to name only the second, and the checker accepted it
// because a weaker read was permitted under a stricter declaration. It is not: a caller
// reading this row would believe everything here is ledger-consistent, and the `explain`
// is not.
// `debit<usd>` and `credit<usd>` are here because `pay_rent` has them. Effect rows are
// transitive, and they were not: a callee's row never reached its caller, so this
// signature used to say `main` moves no money while the first line of its body moves rent.
fn main() -> Result<(), TxnError>
    ! { append, debit<usd>, credit<usd>, read@ledger_consistent, read@snapshot }
{
    let _t = pay_rent(acct(1001), acct(2002))?;
    let b = available_balance.get((acct(1001), usd))?;
    explain b;
    Ok(())
}
